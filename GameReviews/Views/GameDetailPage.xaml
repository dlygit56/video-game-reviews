<UserControl x:Class="GameReviews.Views.GameDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← К списку игр" HorizontalAlignment="Left" Margin="0,0,0,14" Click="Back_Click"/>

        <!-- Карточка игры -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GameEmoji" Grid.Column="0" Style="{StaticResource EmojiText}" FontSize="38"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitle" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GameMeta" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GameDescription" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="GameRating" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    <Button x:Name="WriteButton" Content="Написать рецензию" Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" Click="Write_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рецензии -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Рецензии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Пока нет ни одной рецензии." Style="{StaticResource Muted}" Visibility="Collapsed"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Loaded="ReviewCard_Loaded">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Emoji}" Style="{StaticResource EmojiText}" FontSize="24" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6"/>
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusName, StringFormat='Статус: {0}'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                                   Visibility="{Binding ShowStatus, Converter={StaticResource B2V}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Изменить" Margin="0,0,8,0" Click="Edit_Click"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource B2V}}"/>
                                            <Button Content="{Binding ToggleStatusText}" Margin="0,0,8,0" Click="Toggle_Click"
                                                    Visibility="{Binding CanModerate, Converter={StaticResource B2V}}"/>
                                            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
