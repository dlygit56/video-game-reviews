<UserControl x:Class="GameReviews.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Мой профиль" Style="{StaticResource H1}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="RoleText" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/>
                    <TextBlock x:Name="EmailText" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="SinceText" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>

            <!-- Свои рецензии (критик) -->
            <StackPanel x:Name="MyReviewsPanel" Visibility="Collapsed">
                <TextBlock Text="Мои рецензии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="MyReviewsEmpty" Text="Вы ещё не написали ни одной рецензии." Style="{StaticResource Muted}" Margin="0,0,0,20" Visibility="Collapsed"/>
                <ItemsControl x:Name="MyReviewsList" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Emoji}" Style="{StaticResource EmojiText}" FontSize="20"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusName}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- История просмотров -->
            <TextBlock Text="Просмотренные рецензии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="ViewedEmpty" Text="Вы ещё не открывали рецензии." Style="{StaticResource Muted}" Visibility="Collapsed"/>
            <ItemsControl x:Name="ViewedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding GameTitle}" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
