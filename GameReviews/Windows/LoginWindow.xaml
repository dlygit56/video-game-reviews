<Window x:Class="GameReviews.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyle}">
    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="HeaderText" Text="Вход" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock x:Name="LoginLabel" Text="Имя пользователя или e-mail" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <TextBox x:Name="LoginBox" Margin="0,0,0,12"/>

        <StackPanel x:Name="EmailPanel" Visibility="Collapsed">
            <TextBlock Text="E-mail" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,12"/>
        </StackPanel>

        <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Повторите пароль" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" Margin="0,0,0,12"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed"/>

        <Button x:Name="SubmitButton" Content="Войти" Style="{StaticResource PrimaryButton}" IsDefault="True"
                Click="Submit_Click" Margin="0,4,0,10"/>
        <Button x:Name="SwitchButton" Content="Нет аккаунта? Зарегистрироваться" Click="Switch_Click"
                Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
</Window>
