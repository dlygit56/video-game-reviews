<Window x:Class="GameReviews.ReviewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецензия" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyle}">
    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="Заголовок (необязательно)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" MaxLength="255" Margin="0,0,0,12"/>

        <TextBlock Text="Текст рецензии" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="170"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

        <TextBlock Text="Оценка" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="ScoreSlider" Minimum="1" Maximum="10" TickFrequency="1" Value="7"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" VerticalAlignment="Center"
                    ValueChanged="ScoreSlider_ValueChanged"/>
            <TextBlock x:Name="ScoreEmoji" Grid.Column="1" Style="{StaticResource EmojiText}" FontSize="22" Margin="14,0,8,0"/>
            <TextBlock x:Name="ScoreText" Grid.Column="2" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="44"/>
        </Grid>

        <TextBlock Text="Статус" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="PublishedRadio" Content="Опубликована" IsChecked="True" Margin="0,0,20,0"/>
            <RadioButton x:Name="DraftRadio" Content="Черновик"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
